# Copy to .env (or export in your shell / GitHub Actions secrets).
# Only the notifiers and sources you enable in config.yaml need keys.

# --- Notifiers ---
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# --- Retailer APIs (optional; free keys unless noted) ---
BESTBUY_API_KEY=            # https://developer.bestbuy.com (free)
WALMART_CONSUMER_ID=        # https://walmart.io affiliate API (free, needs RSA key pair)
WALMART_PRIVATE_KEY_PATH=     # or paste the PEM into WALMART_PRIVATE_KEY_PEM (used by GitHub Actions)
WALMART_PRIVATE_KEY_PEM=
WALMART_KEY_VERSION=1
KEEPA_API_KEY=              # https://keepa.com/#!api (paid; Amazon price history + deals)
