# Judge process. Runs separately from the desk, ideally on another host. This is the ONLY place
# the TypeSafe key lives. Copy to .env.judge and fill in.

JUDGE_BACKEND=typesafe            # typesafe | stub (stub needs no key; answers are deterministic noise)
JUDGE_BIND=127.0.0.1
JUDGE_PORT=8787
DESK_SECRET=                      # same value as the desk's DESK_SECRET
JEV_MODEL=                        # same pinned version as the desk's JEV_MODEL. Never jev-latest.
JEV_TIMEOUT_S=8                   # per-call upstream timeout; the desk also passes its block deadline
JEV_MAX_RETRIES=2                 # rate limits and 5xx only; malformed questions are never retried
JUDGE_VERIFY_MODEL_ON_START=1     # check the pinned name against GET /v1/models before serving
# TYPESAFE_API_KEY=               # trading-only key policy applies to exchange keys; this one is an LLM key. Add it yourself.
