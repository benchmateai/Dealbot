# Desk process (the bots). Copy to .env.desk and fill in. Never put the TypeSafe key here:
# the desk refuses to start if TYPESAFE_API_KEY is visible in its environment.

DESK_MODE=shadow                  # shadow: Jev labels, policy logs, nothing executes | paper: executes on the paper broker
DESK_BOT=gambler                  # gambler | house | spy
DESK_SYMBOLS=ETH-USD              # comma separated
BLOCK_SECONDS=12                  # one decision cadence = one block
FEED=synthetic                    # synthetic | replay | coinbase (public level-1 book, no key)
FEED_REPLAY_PATH=                 # JSONL of {ts,sym,bid,ask,bid_qty,ask_qty} when FEED=replay
FEED_POLL_MS=2000                 # coinbase: poll interval per symbol
FEED_BASE_URL=                    # coinbase: default https://api.exchange.coinbase.com

JUDGE_URL=stub://local            # http://127.0.0.1:8787 for the real judge service; stub://local needs no key; stub://demo trades on a script
DESK_SECRET=                      # shared with the judge only. Generate: python -c "import secrets; print(secrets.token_hex(32))"
JEV_MODEL=                        # pinned Jev version string exactly as GET /v1/models lists it. Never jev-latest.
LOG_DIR=logs/data
TRIALS_FILE=                      # default LOG_DIR/trials.json; every configuration ever run is registered here
HEARTBEAT_EVERY_BLOCKS=10         # equity sampling interval; the trial report builds returns from it

# Risk limits (hard vetoes, checked before every order; no model can override them)
MAX_POSITION_UNITS=1.0
MAX_NOTIONAL_USD=5000
DAILY_LOSS_LIMIT_USD=100
MAX_LEVERAGE=1.0
RANGE_GUARD_BPS=50                # order price must be within this of mid
RANGE_GUARD_REF_BPS=300           # mid must be within this of the slow reference mid (bad-data guard)
MIN_EDGE_MARGIN=0.5               # expected edge must exceed (1 + margin) x (fees + gas)
FEE_BPS=10                        # taker fee, paid by market orders (gambler, spy)
MAKER_FEE_BPS=2                   # maker fee, paid by resting limit orders (house)
GAS_USD=0.05                      # per transaction, L2-sized; set it to your chain's reality

# Paper broker
PAPER_CASH_USD=10000
PAPER_SLIPPAGE_BPS=1
ORDER_QTY=0.2                     # fixed clip size in base units (skeleton)
